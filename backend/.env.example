# Copy to backend/.env for local development. Never commit backend/.env.
# Every value here is a safe placeholder or a non-secret default.

NODE_ENV=development
# Keep the API on the loopback interface until access control exists (see docs/security/SECURITY-MODEL.md).
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Google Sheets (Phase 2: NOT read by the code yet) ---
# GOOGLE_SHEETS_SPREADSHEET_ID=<spreadsheet-id>
# GOOGLE_SHEETS_RANGE=Formatted Data!A:J
# Path to a service-account key file stored OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
