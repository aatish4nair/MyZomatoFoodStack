# Copy to backend/.env for local development. Never commit backend/.env.
# Every value here is a safe placeholder or a non-secret default.
# Step-by-step setup: docs/development/GOOGLE-SHEETS-SETUP.md

NODE_ENV=development
# Local default: this computer only. 0.0.0.0 (or ::) is accepted ONLY with NODE_ENV=production
# and ALLOWED_HOSTS (or Render's RENDER_EXTERNAL_HOSTNAME) set. See docs/deployment/RENDER.md.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# --- Deployment only (leave empty locally) ---
# Extra hostnames the API answers to, comma-separated, e.g. my-api.onrender.com,my-site.onrender.com
ALLOWED_HOSTS=
# Reverse proxies to trust for the visitor's address (X-Forwarded-For). 0 locally; production only.
TRUST_PROXY_HOPS=0

# --- Google Sheets (leave GOOGLE_SHEET_ID empty to run without real data) ---
# The ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Tab and columns to read (must be column-bounded).
GOOGLE_SHEET_RANGE="'Formatted Data'!A:J"

# Service-account credentials: set exactly ONE of these two.
# Recommended: absolute path to the downloaded JSON key, stored OUTSIDE this project folder.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Alternative: the whole JSON key on one line (only if a file path isn't possible).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sheet refresh policy: reuse a read for this many seconds (10-3600).
SHEET_CACHE_TTL_SECONDS=60
SHEET_REQUEST_TIMEOUT_MS=10000
SHEET_MAX_ROWS=20000
